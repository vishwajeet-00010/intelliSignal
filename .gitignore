# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/

# Test / tooling caches
.pytest_cache/
.coverage

# SUMO files that are generated from the YAML configuration at run time
sumo/routes/*.rou.xml
sumo/additional/*_tls.add.xml
sumo/config/*.sumocfg

# Editor / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Dashboard scratch: simulations started from the Streamlit dashboard.
# The recorded Stage 1 baseline in results/csv/ is kept.
results/data/*.csv

*.lock

.venv/
.venv-*/
__pycache__/
*.pyc

*.lock

# Disposable artifacts of a run. Everything here is written by the code and
# can be regenerated; nothing here is evidence of a reported result.
tmp/
results/custom_runs/
results/custom_workloads/
results/hybrid/
output/**/logs/
results/tripinfo/

# SUMO trip information. The harness reads each file once, immediately
# after the run that wrote it, and deletes it; what lands here is the
# leftovers of a worker that was killed.
results/tripinfo/

# Runs the dashboard measured and kept so it can show them again. They
# are reproducible from the traffic, the controller and the seed, all
# three of which are in the file name.
results/runs/

# Per-episode training logs. The curve that matters is in each run's
# validation_history.json, which is committed.
output/*/logs/
output/**/__pycache__/
