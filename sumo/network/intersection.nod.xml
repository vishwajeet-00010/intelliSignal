<?xml version="1.0" encoding="UTF-8"?>
<!-- IntelliSignal Stage 1 : nodes of the 4-way intersection -->
<nodes xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:noNamespaceSchemaLocation="http://sumo.dlr.de/xsd/nodes_file.xsd">

    <!-- Central signalised junction -->
    <node id="C" x="0.0"    y="0.0"    type="traffic_light" tlType="static" tl="C"/>

    <!-- Four approach end points (network boundary) -->
    <node id="N" x="0.0"    y="200.0"  type="priority"/>
    <node id="S" x="0.0"    y="-200.0" type="priority"/>
    <node id="E" x="200.0"  y="0.0"    type="priority"/>
    <node id="W" x="-200.0" y="0.0"    type="priority"/>

</nodes>
